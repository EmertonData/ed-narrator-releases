{
  "mcpServers": {
    "ed-narrator": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/EmertonData/ed-narrator-releases#subdirectory=mcp-server", "ed-narrator-mcp"],
      "env": {
        "ED_NARRATOR_URL": "${user_config.app_url}",
        "ED_NARRATOR_INPUT_DIRS": "${user_config.input_dirs}",
        "ED_NARRATOR_OUTPUT_DIR": "${user_config.output_dir}"
      }
    }
  }
}
